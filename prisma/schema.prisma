generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  customerEmail   String?
  amountTotal     Int
  currency        String
  status          String
  productName     String
  createdAt       DateTime @default(now())
}
